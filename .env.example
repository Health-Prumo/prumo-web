# Variáveis do front. Vão para o navegador: nunca coloque segredo aqui.
# Copie para .env.local (desenvolvimento) ou .env.production (build do deploy).

# Endereço da API. Local: http://localhost:8000. AWS: https://api.healthprumo.online
VITE_API_URL=http://localhost:8000

# local = sem Cognito, usuário de desenvolvimento. cognito = login real na AWS.
VITE_AUTH_MODE=local

# Só no modo cognito (saem do terragrunt output da unidade dev/auth).
VITE_COGNITO_REGION=us-east-1
VITE_COGNITO_CLIENT_ID=
